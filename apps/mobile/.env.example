EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Fork identity. Replace these example identifiers before distribution.
SUMORE_ANDROID_PACKAGE=com.example.sumore
SUMORE_IOS_BUNDLE_IDENTIFIER=com.example.sumore
SUMORE_APP_SCHEME=sumore
SUMORE_APP_SLUG=sumore

# Optional EAS / push configuration. Use your own account and project.
# SUMORE_EXPO_OWNER=your-expo-account
# SUMORE_EAS_PROJECT_ID=your-eas-project-uuid
# SUMORE_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
# SUMORE_ANDROID_PUSH_REQUIRED=true

# Updates are disabled until explicitly enabled for your own project.
SUMORE_EAS_UPDATES_ENABLED=false

# iOS Screen Time needs Apple Family Controls approval and matching signing.
SUMORE_SCREEN_TIME_ENABLED=false
SUMORE_SCREEN_TIME_REPORTS_ENABLED=false
# SUMORE_IOS_APPLE_TEAM_ID=YOURTEAMID
# SUMORE_IOS_APP_GROUP=group.com.example.sumore

# EXPO_PUBLIC_* values are bundled in the client. Never use service-role keys,
# signing passwords, or Firebase service-account keys here.
