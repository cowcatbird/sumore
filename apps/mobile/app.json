{
  "expo": {
    "name": "sumore",
    "slug": "sumore",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/campsite/sumore-app-icon-charcoal.png",
    "scheme": "sumore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.sumore",
      "icon": "./assets/campsite/sumore-app-icon-charcoal.png",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.sumore",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#24282C",
        "foregroundImage": "./assets/campsite/sumore.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/campsite/sumore.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A151D",
          "image": "./assets/campsite/sumore.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    }
  }
}
